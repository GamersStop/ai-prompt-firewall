{
  "name": "ai-prompt-firewall",
  "version": "1.0.0",
  "description": "Lightweight, developer-first AI prompt security middleware for real-time detection and remediation of sensitive data.",
  "type": "module",
  "bin": {
    "ai-prompt-firewall": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format esm --dts",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GamersStop/ai-prompt-firewall.git"
  },
  "keywords": [
    "ai",
    "security",
    "llm",
    "firewall",
    "pii",
    "redaction"
  ],
  "author": "dreainno",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}